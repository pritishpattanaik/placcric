# Production .env for the Contabo server. Copy to the repo directory on the server as .env.
# Generate the password with: openssl rand -hex 24
POSTGRES_USER=placcric
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=placcric
POSTGRES_PUBLISH=127.0.0.1:5432
PLACCRIC_ENV=production
PLACCRIC_PUBLISH=127.0.0.1:8000

# ---- Mode A: private (recommended until Google sign-in, Milestone 2) ----
# Reach the app only through an SSH tunnel: ssh -L 8000:127.0.0.1:8000 deploy@SERVER
PLACCRIC_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000
PLACCRIC_FORWARDED_ALLOW_IPS=
# Traffic is already encrypted by SSH; Safari rejects Secure cookies on http://localhost.
PLACCRIC_COOKIE_SECURE=false

# ---- Mode B: public HTTPS via Caddy (comment out Mode A lines above) ----
# COMPOSE_PROFILES=https
# PLACCRIC_DOMAIN=placcric.example.com
# PLACCRIC_ALLOWED_HOSTS=placcric.example.com
# PLACCRIC_FORWARDED_ALLOW_IPS=*
# PLACCRIC_COOKIE_SECURE=true

# ---- Optional AI analysis (docs/AI.md) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
PLACCRIC_AI_DAILY_LIMIT=25
PLACCRIC_AI_MAX_OUTPUT_TOKENS=1500
