# PlacCric configuration. Copy to .env and replace every CHANGE_ME. Never commit .env.
# Generate passwords with:  openssl rand -hex 24   (hex keeps them URL-safe)

# --- PostgreSQL (docker compose `db` service) ---
POSTGRES_USER=placcric
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=placcric
# Where the database port is published on this machine. Keep it on 127.0.0.1.
POSTGRES_PUBLISH=127.0.0.1:5432

# --- Application ---
# development | production   (production turns on Secure cookies by default)
PLACCRIC_ENV=development
# Exact Host header values the app accepts (comma-separated). Add your domain in production.
PLACCRIC_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000
# Where the app port is published on this machine. Keep it on 127.0.0.1.
PLACCRIC_PUBLISH=127.0.0.1:8000
# Trust X-Forwarded-* headers from these proxy IPs ("*" only when Caddy is the sole way in). Empty = off.
PLACCRIC_FORWARDED_ALLOW_IPS=
# Override cookie Secure flag (true/false). Empty = true in production, false in development.
PLACCRIC_COOKIE_SECURE=
# Where uploaded scorecard files are kept privately (venv mode). Default: ./uploads (ignored by git).
# In Docker this is the `uploads` volume and needs no setting.
# PLACCRIC_UPLOAD_DIR=

# --- Public HTTPS (production only, optional) ---
# COMPOSE_PROFILES=https
# PLACCRIC_DOMAIN=placcric.example.com

# --- Running without Docker (venv) or the test suite outside Docker ---
# Same credentials as above; the database is reached through the published port.
DATABASE_URL=postgresql://placcric:CHANGE_ME@localhost:5432/placcric
# Separate disposable database; its name must end in _test (tests drop and recreate its schema).
TEST_DATABASE_URL=postgresql://placcric:CHANGE_ME@localhost:5432/placcric_test
