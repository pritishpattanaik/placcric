# Copy to .env and replace the placeholders. Never commit .env.
# PostgreSQL connection for the application database.
DATABASE_URL=postgresql://placcric:CHANGE_ME@localhost:5432/placcric
# Separate, disposable database used only by the automated tests.
# Its name must end in _test; the tests drop and recreate its schema.
TEST_DATABASE_URL=postgresql://placcric:CHANGE_ME@localhost:5432/placcric_test
# development | production
PLACCRIC_ENV=development
